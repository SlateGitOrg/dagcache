# Optional settings. dagcache never reads a .env file itself; export these in
# your shell or CI. Shown with placeholder values.

# Remote cache (overrides cache.remote in dagcache.yaml): s3://bucket/prefix or a directory
DAGCACHE_REMOTE=s3://my-team-bucket/dagcache
# For S3-compatible servers (MinIO, SeaweedFS, Ceph RGW, R2, ...)
DAGCACHE_S3_ENDPOINT_URL=http://localhost:9000
DAGCACHE_S3_REGION=us-east-1
# Default parallelism for `dagcache repro`
DAGCACHE_JOBS=4
# Log level: debug, info, warning
DAGCACHE_LOG=warning

# Standard AWS credential chain (env vars, ~/.aws, instance role) is used for S3.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
